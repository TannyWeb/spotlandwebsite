---
import { urlFor } from '../lib/sanity';

interface Props {
  service: {
    _id: string;
    title: string;
    slug: {
      current: string;
    } | string;
    category: string;
    mainImage?: any;
    schedule?: string;
    featured?: boolean;
  };
}

const { service } = Astro.props;

// Fallback placeholder image from Unsplash (community vibe)
const placeholderImage = 'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&q=80&w=800';

// Get image URL - use Sanity image if available, otherwise use placeholder
let imageUrl = placeholderImage;
if (service.mainImage) {
  try {
    imageUrl = urlFor(service.mainImage).width(800).height(450).fit('crop').auto('format').url();
  } catch (error) {
    console.error('Error generating image URL:', error);
    imageUrl = placeholderImage;
  }
}

// Category display names
const categoryLabels: Record<string, string> = {
  advice: 'Advice & Support',
  health: 'Health & Wellbeing',
  youth: 'Youth Programs',
  education: 'Education & Learning',
};

// Category colors - using teal theme for consistency
const categoryColors: Record<string, string> = {
  advice: 'bg-primary-light text-primary-dark',
  health: 'bg-primary-light text-primary-dark',
  youth: 'bg-primary-light text-primary-dark',
  education: 'bg-primary-light text-primary-dark',
};

// Get the slug value (handle both object and string formats)
const slugValue = typeof service.slug === 'string' ? service.slug : service.slug.current;
const serviceUrl = `/services/${slugValue}`;
---

<div class="bg-white rounded-xl shadow-md border-t-4 border-[#26a1ab] overflow-hidden transition-transform hover:-translate-y-1">
  <article class="group focus-within:ring-2 focus-within:ring-brand-teal focus-within:ring-offset-2">
    <!-- Image Container -->
    <div class="aspect-video w-full overflow-hidden bg-slate-200">
      <img 
        src={imageUrl}
        alt={service.title}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    
    <div class="p-6">
      <div class="mb-3">
      <span class="bg-teal-100 text-[#1b7a82] px-3 py-1 rounded-full text-sm font-medium">
        {categoryLabels[service.category] || service.category}
      </span>
    </div>
    
    <h3 class="text-slate-900 font-bold text-xl mb-3">
    <a 
      href={serviceUrl}
      class="hover:text-brand-teal transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded"
    >
      {service.title}
    </a>
  </h3>
  
  {service.schedule && (
    <p class="text-slate-600 mb-4 flex items-start gap-2 text-base">
      <span class="text-lg" aria-hidden="true">🕐</span>
      <span>{service.schedule}</span>
    </p>
  )}
  
  <a
    href={serviceUrl}
    class="inline-block bg-brand-teal text-white px-6 py-2 rounded-md font-medium hover:bg-brand-dark transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2"
  >
    Learn more
  </a>
    </div>
  </article>
</div>

