---
import { urlFor } from '../lib/sanity';

interface Props {
  partner: {
    _id: string;
    name: string;
    logo?: any;
    description?: string;
    website?: string;
    partnershipType?: string;
  };
}

const { partner } = Astro.props;

// Get logo URL if available
let logoUrl = null;
if (partner.logo) {
  try {
    logoUrl = urlFor(partner.logo).width(600).height(400).fit('max').auto('format').url();
  } catch (error) {
    console.error('Error generating logo URL:', error);
  }
}

// Use placeholder if no logo is available
if (!logoUrl) {
  logoUrl = `https://ui-avatars.com/api/?name=${encodeURIComponent(partner.name)}&size=600&background=26a1ab&color=fff&bold=true&format=png`;
}

// Partner type labels
const typeLabels: Record<string, string> = {
  funding: 'Funding Partner',
  service: 'Service Delivery Partner',
  community: 'Community Partner',
};
---

<div class="group relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow border border-slate-200 h-full flex flex-col">
  {partner.website ? (
    <a
      href={partner.website}
      target="_blank"
      rel="noopener noreferrer"
      class="block focus:outline-none focus:ring-2 focus:ring-brand-teal rounded-xl flex-grow flex flex-col"
      aria-label={`Visit ${partner.name} website`}
    >
      <div class="flex-grow flex items-center justify-center min-h-[150px] py-4">
        <img
          src={logoUrl}
          alt={`${partner.name} logo`}
          class="max-w-full h-auto object-contain"
          loading="lazy"
        />
      </div>

      {partner.description && (
        <div class="mt-4 pt-4 border-t border-slate-200">
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
            {partner.description}
          </p>
        </div>
      )}
    </a>
  ) : (
    <div class="flex-grow flex flex-col">
      <div class="flex-grow flex items-center justify-center min-h-[150px] py-4">
        <img
          src={logoUrl}
          alt={`${partner.name} logo`}
          class="max-w-full h-auto object-contain"
          loading="lazy"
        />
      </div>

      {partner.description && (
        <div class="mt-4 pt-4 border-t border-slate-200">
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
            {partner.description}
          </p>
        </div>
      )}
    </div>
  )}
</div>
