---
// Location coordinates for Spotland Community Association
const lat = 53.620307;
const lng = -2.167422;

const mapEmbedUrl = `https://www.google.com/maps?q=${lat},${lng}&z=16&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
---

<section class="py-12 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200" aria-labelledby="find-us-heading">
  <div class="max-w-7xl mx-auto">
    <h2 id="find-us-heading" class="text-3xl font-bold text-slate-900 mb-8">
      How to Find Us
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
      <!-- Map Section (60% / 3 columns on large screens) -->
      <div class="lg:col-span-3">
        <div class="aspect-video w-full rounded-3xl overflow-hidden shadow-lg border-4 border-brand-teal">
          <iframe
            src={mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map showing location of Spotland Community Association"
          ></iframe>
        </div>
      </div>

      <!-- Info Section (40% / 2 columns on large screens) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Address -->
        <div class="bg-teal-50 p-6 rounded-2xl border-l-4 border-brand-teal">
          <div class="flex items-start gap-3">
            <svg class="w-8 h-8 text-brand-teal flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <h3 class="font-bold text-xl text-slate-900 mb-2">Address</h3>
              <address class="text-slate-700 text-lg not-italic leading-relaxed">
                Spotland Community Association<br />
                92-96 Spotland Road<br />
                Rochdale, OL12 6PJ
              </address>
            </div>
          </div>
        </div>

        <!-- Get Directions Button -->
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full bg-brand-teal text-white text-center px-8 py-4 rounded-3xl font-bold text-lg hover:bg-brand-dark transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 min-h-[56px] flex items-center justify-center gap-2"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Get Directions
        </a>

        <!-- Public Transport -->
        <div class="bg-gradient-to-br from-teal-50 to-blue-50 p-6 rounded-2xl border-l-4 border-blue-500">
          <h3 class="font-bold text-xl text-slate-900 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            Public Transport
          </h3>
          <ul class="space-y-3 text-slate-700">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-orange-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <div>
                <span class="font-semibold">Bus:</span> Bus stops 200 yds away on Spotland Road
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <div>
                <span class="font-semibold">Tram:</span>20 minutes walk - Rochdale Town Centre Metrolink Stop
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <div>
                <span class="font-semibold">Train:</span> 20 minutes walk - Rochdale train station
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-orange-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <div>
                <span class="font-semibold">Walking:</span> 15 minutes from Rochdale town centre
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
