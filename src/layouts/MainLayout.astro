---
import { getNavigation, getFeaturedPost } from '../lib/sanity';
import '../styles/global.css';
import AccreditationBadge from '../components/AccreditationBadge.astro';
import MobileNavMenu from '../components/MobileNavMenu';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Spotland Community Association - Your friendly neighbourhood hub for advice, health, youth programs, and education.' } = Astro.props;

// Fetch navigation data
let navigation;
try {
  navigation = await getNavigation();
} catch (error) {
  console.error('Error fetching navigation:', error);
  navigation = null;
}

// Fetch featured post for footer badge
let featuredPost = null;
try {
  featuredPost = await getFeaturedPost();
} catch (error) {
  console.error('Error fetching featured post:', error);
}

const menuItems = navigation?.header?.menuItems || [];
const footerInfo = navigation?.footer || {};
const featuredPostSlug = featuredPost?.slug?.current || featuredPost?.slug || null;
const featuredPostUrl = featuredPostSlug ? `/news/${featuredPostSlug}` : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-neutral-900 font-sans">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded focus:ring-2 focus:ring-primary focus:ring-offset-2"
    >
      Skip to main content
    </a>

    <!-- Sticky Header -->
    <header class="sticky top-0 z-40 bg-white border-b border-neutral-200 shadow-sm" role="banner">
      <div class="w-full px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center justify-between py-4" role="navigation" aria-label="Main navigation">
          <a
            href="/"
            class="text-xl md:text-2xl font-bold text-slate-900 hover:text-brand-teal transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded py-2 px-1 inline-flex items-center gap-3 min-h-[44px]"
          >
            <img
              src="/logo.png"
              alt=""
              class="h-10 md:h-12 w-auto"
              aria-hidden="true"
            />
            <span class="hidden md:inline">Spotland Community Association</span>
          </a>

          <div class="flex items-center gap-6">
            {/* Mobile Navigation */}
            <MobileNavMenu client:load menuItems={menuItems} />

            {/* Desktop Navigation */}
            {menuItems.length > 0 && (
              <ul class="hidden md:flex gap-1">
                {menuItems.map((item: any) => (
                  <li>
                    <a
                      href={item.link}
                      class="text-base text-neutral-700 hover:text-brand-teal font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded px-4 py-2.5 inline-flex items-center min-h-[44px]"
                      target={item.openInNewTab ? '_blank' : undefined}
                      rel={item.openInNewTab ? 'noopener noreferrer' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
                <li>
                  <a
                    href="/#get-in-touch"
                    class="text-base text-neutral-700 hover:text-brand-teal font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded px-4 py-2.5 inline-flex items-center min-h-[44px]"
                  >
                    Contact Us
                  </a>
                </li>
              </ul>
            )}
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-grow" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 py-16 text-white mt-auto" role="contentinfo">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h2 class="text-2xl md:text-3xl font-bold !text-white mb-3">Spotland Community Association</h2>
          <p class="text-base md:text-lg mb-8 text-slate-300">
            Registered Charity | Serving the community since 1996
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left md:text-center mb-12">
            <div>
              <h3 class="text-lg font-semibold text-white mb-3">Contact</h3>
              <p class="text-slate-300 text-base mb-2">Spotland Community Association</p>
              <p class="text-slate-300 text-base mb-2">Spotland Road, Rochdale</p>
              <p class="text-slate-300 text-base">OL12 6PJ</p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-white mb-3">Get In Touch</h3>
              <p class="mb-2">
                <a
                  href="tel:01706354151"
                  class="text-teal-300 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-slate-900 rounded px-2 py-1 inline-flex items-center min-h-[44px] text-base"
                >
                  01706 354151
                </a>
              </p>
              <p>
                <a
                  href="mailto:asgharspotlandcc@inbox.com"
                  class="text-teal-300 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-slate-900 rounded px-2 py-1 inline-flex items-center min-h-[44px] text-base break-all"
                >
                  asgharspotlandcc@inbox.com
                </a>
              </p>
              <p class="mt-2">
                <a
                  href="https://www.facebook.com/people/Spotland-Community-Association/61583888570800/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900 rounded px-2 py-1 inline-flex items-center gap-2 min-h-[44px] text-base"
                  aria-label="Follow us on Facebook (opens in new tab)"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                  </svg>
                  Follow us on Facebook
                </a>
              </p>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-white mb-3">Opening Hours</h3>
              <p class="text-slate-300 text-base mb-1">Monday - Friday: 9:00 AM - 4:00 PM</p>
    
            </div>
          </div>
        </div>

        <div class="border-t border-slate-800 pt-8 text-center">
          <p class="text-base text-slate-400 mb-2">
            Made with <span class="text-red-400">❤️</span> for our community
          </p>
          <p class="text-sm text-slate-500">
            &copy; {new Date().getFullYear()} Spotland Community Association. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Import Outfit and Inter fonts */
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

  /* Apply Outfit to all headings */
  h1, h2, h3, h4, h5, h6,
  .heading-1, .heading-2, .heading-3, .heading-4 {
    font-family: 'Outfit', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  
  /* Custom teal color for Tailwind */
  :root {
    --color-teal: #26a1ab;
    --color-teal-dark: #1e7e86;
  }
  
  /* Ensure focus indicators are always visible - WCAG AA compliant */
  *:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }
  
  /* Screen reader only utility (for accessibility) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  
  .sr-only.focus\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>

