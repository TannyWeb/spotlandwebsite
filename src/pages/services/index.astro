---
import MainLayout from '../../layouts/MainLayout.astro';
import { getServices } from '../../lib/sanity';
import ServiceCard from '../../components/ServiceCard';

// Fetch all services from Sanity
let services = [];
try {
  services = await getServices();
} catch (error) {
  console.error('Error fetching services:', error);
}

// Category display names
const categoryLabels: Record<string, string> = {
  advice: 'Advice & Support',
  health: 'Health & Wellbeing',
  youth: 'Youth Programs',
  education: 'Education & Learning',
};
---

<MainLayout
  title="Our Services - Spotland Community Centre"
  description="Explore all the services available at Spotland Community Centre. We're here to help with advice, health, youth programs, and education."
>
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <!-- Page Header -->
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-2 bg-teal-100 text-teal-800 rounded-full text-sm font-medium mb-4">
          Community Services
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
          Our Services
        </h1>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
          We're here to support you and your family with a friendly smile and helping hand.
          Browse all our services below – there's something for everyone!
        </p>
      </div>

      <!-- Services Grid -->
      {services.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {services.map((service: any) => (
            <ServiceCard service={service} client:load />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-slate-600">
            We're setting up our services. Check back soon – we can't wait to welcome you!
          </p>
        </div>
      )}
    </div>
  </section>
</MainLayout>

