---
import MainLayout from '../../layouts/MainLayout.astro';
import { getServiceBySlug, getFeaturedPost } from '../../lib/sanity';
import ServiceDetail from '../../components/ServiceDetail';

const { slug } = Astro.params;

// Fetch the specific service
let service = null;
try {
  service = await getServiceBySlug(slug || '');
} catch (error) {
  console.error('Error fetching service:', error);
}

// If service not found, return 404
if (!service) {
  return Astro.redirect('/404');
}

// Fetch featured post for accreditation badge
let featuredPost = null;
try {
  featuredPost = await getFeaturedPost();
} catch (error) {
  console.error('Error fetching featured post:', error);
}

const featuredPostSlug = featuredPost?.slug?.current || featuredPost?.slug || null;
---

<MainLayout 
  title={`${service.title} - Spotland Community Centre`}
  description={`Learn about our ${service.title} service at Spotland Community Centre.`}
>
  <!-- Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" class="bg-slate-100 py-4 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 mb-8 rounded-lg">
    <ol class="flex items-center gap-2 text-base">
      <li>
        <a href="/" class="text-brand-teal hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded px-2 py-2 inline-flex items-center min-h-[44px]">
          Home
        </a>
      </li>
      <li aria-hidden="true" class="text-slate-400 text-lg">/</li>
      <li>
        <a href="/services" class="text-brand-teal hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded px-2 py-2 inline-flex items-center min-h-[44px]">
          Services
        </a>
      </li>
      <li aria-hidden="true" class="text-slate-400 text-lg">/</li>
      <li>
        <span class="text-slate-900 font-medium px-2 py-2 inline-flex items-center">{service.title}</span>
      </li>
    </ol>
  </nav>

  <!-- Service Content -->
  <article>
    <div class="max-w-7xl mx-auto">
      <ServiceDetail service={service} featuredPostSlug={featuredPostSlug} client:load />
    </div>
  </article>

  <!-- Sticky Contact Footer (Mobile) -->
  <div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white border-t border-slate-200 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <a
        href="tel:01706123456"
        class="w-full inline-flex items-center justify-center gap-2 bg-brand-accent text-white hover:bg-[#b86505] font-bold text-lg rounded-full px-6 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 min-h-[48px]"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Contact Us Now
      </a>
    </div>
  </div>

  <!-- Add padding to bottom of article to account for sticky footer on mobile -->
  <style>
    @media (max-width: 768px) {
      article {
        padding-bottom: 80px;
      }
    }
  </style>
</MainLayout>


