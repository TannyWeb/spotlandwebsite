---
import MainLayout from '../../layouts/MainLayout.astro';
import { getPostBySlug } from '../../lib/sanity';
import PostDetail from '../../components/PostDetail.astro';

const { slug } = Astro.params;

// Fetch the specific post
let post = null;
try {
  post = await getPostBySlug(slug || '');
} catch (error) {
  console.error('Error fetching post:', error);
}

// If post not found, return 404
if (!post) {
  return Astro.redirect('/404');
}
---

<MainLayout 
  title={`${post.title} - Spotland Community Centre`}
  description={`${post.title} - Latest news from Spotland Community Centre.`}
>
  <!-- Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" class="bg-slate-100 py-4 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 mb-8 rounded-lg">
    <ol class="flex items-center gap-2 text-base">
      <li>
        <a href="/" class="text-brand-teal hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded px-2 py-2 inline-flex items-center min-h-[44px]">
          Home
        </a>
      </li>
      <li aria-hidden="true" class="text-slate-400 text-lg">/</li>
      <li>
        <a href="/news" class="text-brand-teal hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 rounded px-2 py-2 inline-flex items-center min-h-[44px]">
          News
        </a>
      </li>
      <li aria-hidden="true" class="text-slate-400 text-lg">/</li>
      <li>
        <span class="text-slate-900 font-medium px-2 py-2 inline-flex items-center">{post.title}</span>
      </li>
    </ol>
  </nav>

  <!-- Post Content -->
  <PostDetail post={post} />

  <!-- Back Link -->
  <div class="mt-12 pt-8 border-t border-slate-200">
    <a 
      href="/news" 
      class="inline-flex items-center gap-2 text-[#26a1ab] hover:text-[#1b7a82] font-medium focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded min-h-[44px] px-4"
    >
      ← Back to all news
    </a>
  </div>
</MainLayout>

