---
import MainLayout from '../layouts/MainLayout.astro';
import { getAboutPageContent, getTeamMembers, getPartners, getAllPosts, getFeaturedPost } from '../lib/sanity';
import { urlFor } from '../lib/sanity';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import NewsCard from '../components/NewsCard.astro';
import WaveDivider from '../components/WaveDivider.astro';
import PortableText from '../components/PortableText';
import AccreditationBadge from '../components/AccreditationBadge.astro';

// Fetch all data
let aboutContent = null;
let team = [];
let partners = [];
let posts = [];
let featuredPost = null;

try {
  aboutContent = await getAboutPageContent();
  team = await getTeamMembers();
  partners = await getPartners();
  posts = await getAllPosts();
  featuredPost = await getFeaturedPost();
} catch (error) {
  console.error('Error fetching about page data:', error);
}

const featuredPostSlug = featuredPost?.slug?.current || featuredPost?.slug || null;

// Get story image URL if available
let storyImageUrl = null;
if (aboutContent?.ourStoryImage) {
  try {
    storyImageUrl = urlFor(aboutContent.ourStoryImage).width(800).height(600).fit('crop').auto('format').url();
  } catch (error) {
    console.error('Error generating story image URL:', error);
  }
}
---

<MainLayout title={aboutContent?.title || "About Spotland Community Association"}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="bg-teal-gradient py-20 md:py-28">
      <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <!-- Pill badge -->
        <div class="inline-flex items-center gap-2 mb-6 bg-white/20 text-white px-4 py-2 rounded-full text-sm font-medium backdrop-blur-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Get to Know Us</span>
        </div>

        <h1 class="text-white text-4xl md:text-5xl lg:text-7xl font-extrabold mb-6 leading-none drop-shadow-md tracking-tight">
          {aboutContent?.title || "The Heart of Our Community"}
        </h1>
        <p class="text-white/95 text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed">
        A registered charity to help and support communities around Spotland and Lower Falinge. 
        </p>
      </div>
    </div>
    <WaveDivider position="bottom" fill="white" />
  </section>

  <!-- Mission & Values Cards -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Our Mission -->
        <div class="bg-white rounded-[2rem] p-10 shadow-xl shadow-teal-900/5 border border-slate-50 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-teal-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-110"></div>
          <div class="relative z-10">
            <div class="w-16 h-16 bg-teal-100 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h2 class="text-3xl font-bold text-slate-900 mb-4 tracking-tight">Our Mission</h2>
            <p class="text-slate-600 text-lg leading-relaxed">
              We want to help everyone in our community feel strong and connected. We offer friendly support, learning, and a warm welcome for all.
            </p>
          </div>
        </div>

        <!-- Our Values -->
        <div class="bg-white rounded-[2rem] p-10 shadow-xl shadow-teal-900/5 border border-slate-50 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-orange-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-110"></div>
          <div class="relative z-10">
            <div class="w-16 h-16 bg-orange-100 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h2 class="text-3xl font-bold text-slate-900 mb-4 tracking-tight">Our Values</h2>
            <p class="text-slate-600 text-lg leading-relaxed">
              Kindness, respect, and working together are at the heart of everything we do. We believe that we are stronger when we help each other.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story Section -->
  {aboutContent?.ourStory && (
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Image with decorative elements -->
          <div class="relative order-2 lg:order-1">
            <div class="absolute -top-6 -left-6 w-full h-full border-4 border-brand-teal/20 rounded-[2.5rem] z-0 hidden md:block"></div>
            <div class="relative z-10 rounded-[2.5rem] overflow-hidden shadow-2xl">
              {storyImageUrl ? (
                <img
                  src={storyImageUrl}
                  alt="Our community hub in action"
                  class="w-full h-full object-cover aspect-[4/3]"
                />
              ) : (
                <div class="w-full aspect-[4/3] bg-teal-100 flex items-center justify-center">
                  <svg class="w-20 h-20 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
              )}
            </div>
            <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-brand-accent/10 rounded-full blur-3xl z-0"></div>
          </div>

          <!-- Content -->
          <div class="order-1 lg:order-2">
            <div class="inline-flex items-center gap-2 mb-6 bg-brand-teal/10 text-brand-teal px-4 py-1.5 rounded-full text-sm font-semibold">
              <span>Our Journey</span>
            </div>
            <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-8 tracking-tight leading-tight">
              Helping our neighbours for over 28 years
            </h2>
            <div class="prose-container">
              <PortableText content={aboutContent.ourStory} />
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Languages Callout Banner -->
  <section class="py-12 bg-teal-gradient px-4 sm:px-6 lg:px-8 overflow-hidden relative">
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100 C 20 0 50 0 100 100" stroke="white" fill="transparent" stroke-width="0.5" />
      </svg>
    </div>
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12">
        <div class="text-white">
          <h3 class="text-2xl md:text-3xl font-bold mb-2 tracking-tight">Everyone is welcome here</h3>
          <p class="text-teal-50 text-lg md:text-xl font-medium">
            We speak Urdu, Punjabi and Arabic. We’re here to help you in the language you’re most comfortable with.
          </p>
        </div>
        <div class="flex gap-3">
          <span class="bg-white/20 text-white px-4 py-2 rounded-xl font-bold text-lg backdrop-blur-sm">Urdu</span>
          <span class="bg-white/20 text-white px-4 py-2 rounded-xl font-bold text-lg backdrop-blur-sm">Punjabi</span>
          <span class="bg-white/20 text-white px-4 py-2 rounded-xl font-bold text-lg backdrop-blur-sm">Arabic</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Staff Section -->
  {(aboutContent?.showTeam !== false) && team.length > 0 && (
    <section class="py-24 bg-slate-50 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 mb-4 bg-teal-100 text-teal-700 px-4 py-1.5 rounded-full text-sm font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span>Our Team</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 tracking-tight">
            The friendly faces you'll see
          </h2>
          <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
            Our dedicated staff are here to help you feel at home. Meet the people who make everything happen at the Association.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {team.map((member: any) => (
            <TeamMemberCard member={member} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Our Partners Section -->
  {(aboutContent?.showPartners !== false) && partners.length > 0 && (
    <section class="py-24 bg-white px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 mb-4 bg-orange-100 text-orange-700 px-4 py-1.5 rounded-full text-sm font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span>Working Together</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 tracking-tight">
            Our Partners
          </h2>
          <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
            We work with amazing organisations to bring you the best possible support and services right here in Rochdale.
          </p>
        </div>

        <!-- Partner logos grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mb-16">
          {partners.map((partner: any) => (
            <PartnerLogo partner={partner} />
          ))}
        </div>

        <!-- Interested in Partnering CTA -->
        <div class="bg-gradient-to-br from-teal-50 to-white rounded-[2.5rem] p-12 text-center border-2 border-teal-100/50 shadow-sm relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-teal-100/20 rounded-full -mr-32 -mt-32 blur-3xl"></div>
          <h3 class="text-3xl font-bold text-slate-900 mb-4 tracking-tight">
            Want to work with us?
          </h3>
          <p class="text-xl text-slate-600 mb-8 max-w-xl mx-auto leading-relaxed">
            We’re always looking for new ways to support our community. If your organisation shares our vision, we’d love to talk.
          </p>
          <a
            href="mailto:asgharspotlandcc@inbox.com?subject=Partnership Enquiry"
            class="inline-flex items-center gap-3 bg-brand-teal hover:bg-brand-dark text-white px-8 py-4 rounded-full font-bold text-lg shadow-2xl transition-all hover:scale-105 min-h-[44px]"
          >
            Discuss a partnership
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Quality & Accreditation -->
  <section class="py-24 bg-slate-900 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="text-4xl font-bold !text-white mb-6 tracking-tight">Quality You Can Trust</h2>
      <p class="text-xl text-slate-300 mb-12 max-w-2xl mx-auto leading-relaxed">
        We’re proud to be a registered charity that has been serving our community with care and dedication since 1996.
      </p>
      
      <div class="flex flex-col md:flex-row items-center justify-center gap-8">
        <AccreditationBadge postSlug={featuredPostSlug} />
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10">
          <p class="text-white font-medium text-lg">
            Registered Charity No. 1055809
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- News & Updates Section -->
  {posts.length > 0 && (
    <section class="py-24 bg-white px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4 tracking-tight">
              Latest from the Spotland Association
            </h2>
            <p class="text-xl text-slate-600 max-w-2xl leading-relaxed">
              Check out our latest news, stories, and updates from the Spotland community.
            </p>
          </div>
          <a href="/news" class="text-brand-teal font-bold text-lg hover:underline inline-flex items-center gap-2 min-h-[44px]">
            View all news
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {posts.slice(0, 3).map((post: any) => (
            <NewsCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>
