---
import MainLayout from '../../layouts/MainLayout.astro';
import { getGalleryBySlug, getAllGallerySlugs, urlFor } from '../../lib/sanity';
import ImageLightbox from '../../components/ImageLightbox';

// Static generation for all gallery slugs
export async function getStaticPaths() {
  const slugs = await getAllGallerySlugs();
  return slugs.map((slug: string) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// Fetch the gallery data
let gallery = null;
try {
  gallery = await getGalleryBySlug(slug as string);
} catch (error) {
  console.error('Error fetching gallery:', error);
}

// If gallery not found, redirect to 404
if (!gallery) {
  return Astro.redirect('/404');
}

// Prepare photos for lightbox
const photos = gallery.photos?.map((photo: any) => ({
  imageUrl: photo.image?.asset
    ? urlFor(photo.image).width(1200).height(900).fit('max').auto('format').url()
    : '',
  caption: photo.caption || '',
  altText: photo.altText || 'Photo from gallery',
})).filter((p: any) => p.imageUrl) || [];

// Cover image URL
const coverImageUrl = gallery.coverImage?.asset
  ? urlFor(gallery.coverImage).width(1920).height(600).fit('crop').auto('format').url()
  : null;
---

<MainLayout
  title={`${gallery.title} - Photo Gallery - Spotland Community Centre`}
  description={gallery.description || `Browse photos from ${gallery.title} at Spotland Community Centre.`}
>
  <!-- Hero Section -->
  <section class="relative bg-slate-900">
    {coverImageUrl && (
      <div class="absolute inset-0">
        <img
          src={coverImageUrl}
          alt=""
          class="w-full h-full object-cover opacity-40"
          aria-hidden="true"
        />
      </div>
    )}
    <div class="relative py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <!-- Back link -->
        <a
          href="/gallery"
          class="inline-flex items-center gap-2 text-white/80 hover:text-white transition-colors mb-6 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-900 rounded"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Gallery
        </a>

        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {gallery.title}
        </h1>

        {gallery.description && (
          <p class="text-xl text-white/80 max-w-3xl leading-relaxed">
            {gallery.description}
          </p>
        )}

        <div class="flex items-center gap-4 mt-6 text-white/70">
          {gallery.publishedAt && (
            <span>
              {new Date(gallery.publishedAt).toLocaleDateString('en-GB', {
                year: 'numeric',
                month: 'long',
              })}
            </span>
          )}
          <span>•</span>
          <span>{photos.length} {photos.length === 1 ? 'photo' : 'photos'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Grid with Lightbox -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      {photos.length > 0 ? (
        <ImageLightbox photos={photos} client:load />
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-slate-600">
            Photos coming soon!
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- Back to Gallery CTA -->
  <section class="py-8 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-7xl mx-auto text-center">
      <a
        href="/gallery"
        class="inline-flex items-center gap-2 px-6 py-3 bg-brand-teal text-white font-medium rounded-full hover:bg-brand-dark transition-colors min-h-[44px] focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Browse More Albums
      </a>
    </div>
  </section>
</MainLayout>
