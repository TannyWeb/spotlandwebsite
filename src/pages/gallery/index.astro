---
import MainLayout from '../../layouts/MainLayout.astro';
import { getGalleries } from '../../lib/sanity';
import GalleryCard from '../../components/GalleryCard.astro';

// Fetch all galleries from Sanity
let galleries = [];
try {
  galleries = await getGalleries();
} catch (error) {
  console.error('Error fetching galleries:', error);
}
---

<MainLayout
  title="Photo Gallery - Spotland Community Centre"
  description="Browse photos from our community events, programs, and activities at Spotland Community Centre."
>
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <!-- Page Header -->
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-2 bg-teal-100 text-teal-800 rounded-full text-sm font-medium mb-4">
          Photo Gallery
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
          Our Community in Pictures
        </h1>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
          Take a look at what we've been up to! Browse photos from our events,
          programs, and the wonderful people who make our community special.
        </p>
      </div>

      <!-- Gallery Grid -->
      {galleries.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {galleries.map((gallery: any) => (
            <GalleryCard gallery={gallery} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-slate-600">
            We're adding photos soon. Check back to see our community in action!
          </p>
        </div>
      )}
    </div>
  </section>
</MainLayout>
