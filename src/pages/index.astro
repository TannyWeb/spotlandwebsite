---
import MainLayout from '../layouts/MainLayout.astro';
import { getServices, getPosts } from '../lib/sanity';
import ServiceCard from '../components/ServiceCard';
import NewsCard from '../components/NewsCard.astro';

// Fetch all services from Sanity using GROQ query
let services = [];
try {
  services = await getServices();
} catch (error) {
  console.error('Error fetching services:', error);
}

// Fetch latest posts
let posts = [];
try {
  posts = await getPosts(3);
  console.log('[index.astro] Posts fetched:', posts.length, posts);
} catch (error) {
  console.error('Error fetching posts:', error);
}

// Separate featured and regular services
const featuredServices = services.filter((service: any) => service.featured);
const regularServices = services.filter((service: any) => !service.featured);
---

<MainLayout title="Welcome to Spotland Community Centre">
  <!-- Hero Section -->
  <section class="-mx-4 px-4" aria-labelledby="hero-heading">
    <div class="bg-[#26a1ab] py-20 px-4 text-center border-b border-brand-dark">
      <h1 id="hero-heading" class="text-white font-extrabold text-4xl mb-4">
        Welcome to your Community Hub
      </h1>
      <p class="text-teal-50 mb-8 max-w-2xl mx-auto">
        We're here to support you and your family with a friendly smile and helping hand. 
        Explore our services below – there's something for everyone!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/services"
          class="inline-flex items-center justify-center gap-2 bg-white text-[#26a1ab] hover:bg-teal-50 font-bold text-lg rounded-full px-8 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#26a1ab] min-h-[48px]"
        >
          Explore Services
        </a>
        <a
          href="tel:01619999999"
          class="inline-flex items-center justify-center gap-2 bg-[#d97706] text-white hover:bg-[#b86505] font-bold text-lg rounded-full px-8 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-[#d97706] focus:ring-offset-2 focus:ring-offset-[#26a1ab] min-h-[48px]"
        >
          Contact the Hub
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Services -->
  {featuredServices.length > 0 && (
    <section class="py-12" aria-labelledby="featured-heading">
      <div>
        <h2 id="featured-heading" class="text-3xl font-bold text-slate-900 mb-8">
          Featured Services
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          {featuredServices.map((service: any) => (
            <ServiceCard service={service} client:load />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- All Services -->
  <section class="py-12 bg-neutral-50 -mx-4 px-4" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="services-heading" class="text-3xl font-bold text-slate-900 mb-8">
        {featuredServices.length > 0 ? 'More Services' : 'Our Services'}
      </h2>
      
      {regularServices.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {regularServices.map((service: any) => (
            <ServiceCard service={service} client:load />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-slate-600">
            We're setting up our services. Check back soon – we can't wait to welcome you!
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- Latest from the Hub -->
  <section class="py-12" aria-labelledby="news-heading">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
        <h2 id="news-heading" class="text-3xl font-bold text-slate-900 mb-4 sm:mb-0">
          Latest from the Hub
        </h2>
        <a
          href="/news"
          class="inline-flex items-center justify-center border-2 border-brand-teal text-brand-teal hover:bg-brand-teal hover:text-white font-semibold text-base rounded-full px-6 py-2.5 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 min-h-[44px] self-start sm:self-auto"
        >
          View All News
        </a>
      </div>
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post: any) => (
            <NewsCard post={post} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-slate-600">
            No news posts yet. Check back soon for updates from the Hub!
          </p>
          <p class="text-sm text-slate-500 mt-2">
            Debug: Posts array length is {posts.length}. Check console logs for details.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-teal-50 text-slate-900 py-12 -mx-4 px-4" aria-labelledby="cta-heading">
    <div class="max-w-7xl mx-auto text-center">
      <h2 id="cta-heading" class="text-3xl font-bold mb-4 text-slate-900">
        Have Questions? We'd Love to Hear From You!
      </h2>
      <p class="text-xl text-slate-900 mb-6 max-w-2xl mx-auto">
        Our friendly team is here to help you find the right service or answer any questions you might have.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="tel:01619999999"
          class="inline-flex items-center justify-center gap-2 bg-[#d97706] text-white hover:bg-[#b86505] font-bold text-lg rounded-full px-8 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-[#d97706] focus:ring-offset-2 focus:ring-offset-teal-50 min-h-[48px]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Give Us a Call
        </a>
        <a
          href="mailto:info@spotlandcommunity.org"
          class="inline-flex items-center justify-center gap-2 bg-[#d97706] text-white hover:bg-[#b86505] font-bold text-lg rounded-full px-8 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-[#d97706] focus:ring-offset-2 focus:ring-offset-teal-50 min-h-[48px]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Send an Email
        </a>
      </div>
    </div>
  </section>
</MainLayout>
