---
import MainLayout from '../layouts/MainLayout.astro';
import { getServices, getPosts } from '../lib/sanity';
import ServiceCard from '../components/ServiceCard';
import NewsCard from '../components/NewsCard.astro';
import WhatsOnToday from '../components/WhatsOnToday.astro';
import FindUs from '../components/FindUs.astro';
import WaveDivider from '../components/WaveDivider.astro';

// Fetch all services from Sanity using GROQ query
let services = [];
try {
  services = await getServices();
} catch (error) {
  console.error('Error fetching services:', error);
}

// Fetch latest posts
let posts = [];
try {
  posts = await getPosts(3);
} catch (error) {
  console.error('Error fetching posts:', error);
}
---

<MainLayout title="Spotland Community Association - Rochdale">
  <!-- Hero Section with Image and Gradient Overlay -->
  <section class="relative overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?w=1600&h=900&fit=crop"
        alt=""
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-hero-overlay"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-32">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-extrabold mb-6 leading-tight drop-shadow-lg tracking-tight">
          Spotland Community<br />Association
        </h1>
        <p class="text-white/95 text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed mb-8">
          Supporting communities in Spotland with Care, Inclusion, and Hope
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="services"
            class="bg-white hover:bg-gray-100 text-brand-teal font-semibold px-8 py-3.5 rounded-full transition-colors shadow-lg hover:shadow-xl inline-flex items-center min-h-[44px] text-lg"
          >
            Explore Our Services
          </a>
          <a
            href="tel:01706354151"
            class="bg-transparent hover:bg-white/10 text-white font-semibold px-8 py-3.5 rounded-full border-2 border-white transition-colors inline-flex items-center min-h-[44px] text-lg gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Us: 01706 354151
          </a>
        </div>
      </div>
    </div>

    <!-- Wave Divider -->
    <WaveDivider position="bottom" fill="white" />
  </section>

  <!-- Mission, Projects, Staff Cards -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Our Mission -->
        <div class="text-center">
          <div class="w-16 h-16 bg-cyan-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-3">Our Mission</h2>
          <p class="text-slate-600 leading-relaxed">
            To empower individuals and strengthen communities through inclusive programs, education, and a welcoming space where everyone belongs.
          </p>
        </div>

        <!-- Community Projects -->
        <div class="text-center">
          <div class="w-16 h-16 bg-orange-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-3">Community Projects</h2>
          <p class="text-slate-600 leading-relaxed">
            Local programs that connect neighbours, support families, and build a stronger community together.
          </p>
        </div>

        <!-- Dedicated Staff -->
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-3">Dedicated Staff</h2>
          <p class="text-slate-600 leading-relaxed">
            Our friendly team is here to support you with care, respect, and understanding every step of the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's On Section -->
  <WhatsOnToday services={services} />

  <!-- About Us Section with Stats -->
  <section id="about" class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-teal font-semibold text-lg mb-2">About Us</p>
        <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
          Spotland Community Association
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
          Spotland Community Association is a registered charity which works with local communities - providing support, advice & guidance around welfare rights/ benefits, education & training and social inclusion activities to improve the overall quality of life. The charity started back in 1996 and has continued ever since. We work with all age groups delivering projects and services through our educational programmes and training.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="w-14 h-14 bg-cyan-50 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
