            </svg>
          </div>
          <p class="text-4xl font-bold text-brand-teal mb-2">1000+</p>
          <p class="text-slate-600 font-medium">Community Members</p>
        </div>

        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="w-14 h-14 bg-cyan-50 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <p class="text-4xl font-bold text-brand-teal mb-2">Multiple</p>
          <p class="text-slate-600 font-medium">Local Services</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Get In Touch -->
  <section id="get-in-touch" class="py-14 bg-gradient-to-br from-teal-50 to-white px-4 sm:px-6 lg:px-8 border-t-4 border-brand-teal">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          Get In Touch
        </h2>
        <p class="text-xl text-slate-700 max-w-2xl mx-auto">
          We're here to help. Drop in, call, or send us a message.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
