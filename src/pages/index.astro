  <!-- How to Find Us -->
  <FindUs />

  <!-- Teal Gradient CTA Section -->
  <section class="relative overflow-hidden">
    <div class="bg-teal-gradient py-20 md:py-24">
      <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Ready to Make a Difference?
        </h2>
        <p class="text-xl md:text-2xl text-white/95 mb-8 leading-relaxed">
          Join our programmes today and take the first step toward a brighter future.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="tel:01706354151"
            class="bg-white hover:bg-gray-100 text-brand-teal font-semibold px-8 py-3.5 rounded-full transition-colors shadow-lg hover:shadow-xl inline-flex items-center min-h-[44px] text-lg gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Us: 01706 354151
          </a>
          <a
            href="mailto:asgharspotlandcc@inbox.com"
            class="bg-transparent hover:bg-white/10 text-white font-semibold px-8 py-3.5 rounded-full border-2 border-white transition-colors inline-flex items-center min-h-[44px] text-lg gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email Us
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
