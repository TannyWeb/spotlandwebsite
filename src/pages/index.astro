              <p class="text-slate-600">
                Our friendly team is ready to help.
              </p>
            </div>
          </div>
          <div class="space-y-4">
            <div>
              <span class="text-slate-600 text-sm font-medium">Phone</span>
              <p class="mt-1">
                <a href="tel:01706354151" class="text-brand-teal text-xl font-bold hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal rounded inline-flex items-center min-h-[44px]">01706 354151</a>
              </p>
            </div>
            <div>
              <span class="text-slate-600 text-sm font-medium">WhatsApp</span>
              <p class="mt-1">
                <a href="tel:07719977277" class="text-brand-teal text-xl font-bold hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal rounded inline-flex items-center min-h-[44px]">07719 977277</a>
              </p>
            </div>
            <div>
              <span class="text-slate-600 text-sm font-medium">Address</span>
              <p class="text-slate-900 mt-1 leading-relaxed">
                Spotland Community Association<br />
                92-96 Spotland Road<br />
                Rochdale, OL12 6PJ
              </p>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div class="bg-white rounded-3xl p-8 shadow-md border-t-4 border-brand-accent">
          <div class="flex items-start gap-4 mb-6">
            <div class="bg-orange-100 p-3 rounded-full">
              <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-xl text-slate-900 mb-2">Email Us</h3>
              <p class="text-slate-600">
                We'll reply within 2 working days.
              </p>
            </div>
          </div>
          <div class="space-y-4">
            <div>
              <span class="text-slate-600 text-sm font-medium">Email</span>
              <p class="mt-1">
                <a href="mailto:asgharspotlandcc@inbox.com" class="text-brand-teal text-lg font-bold hover:text-brand-dark hover:underline focus:outline-none focus:ring-2 focus:ring-brand-teal rounded inline-flex items-center min-h-[44px] break-all">asgharspotlandcc@inbox.com</a>
              </p>
            </div>
            <div class="bg-teal-50 border-l-4 border-brand-teal p-4 rounded-r-lg">
              <p class="text-slate-700 text-sm flex items-start gap-2">
                <svg class="w-5 h-5 text-brand-teal flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
                </svg>
                <span>We speak Urdu, Punjabi & Arabic. Please let us know if you need support in any other languages.</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Follow Us on Facebook -->
        <div class="bg-white rounded-3xl p-8 shadow-md border-t-4 border-blue-500">
          <div class="flex items-start gap-4 mb-6">
            <div class="bg-blue-100 p-3 rounded-full">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
