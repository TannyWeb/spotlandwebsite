# Sanity CMS Configuration
# Get these values from your Sanity project dashboard: https://www.sanity.io/manage
# Note: PUBLIC_ prefix is required for client-side access in Astro
PUBLIC_SANITY_PROJECT_ID=your-project-id-here
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01
PUBLIC_SANITY_USE_CDN=false

# Optional: Sanity API Token (only needed for write operations, server-only)
# SANITY_API_TOKEN=your-api-token-here

